# Permitir acceso a archivos PDF
<Files "*.pdf">
    Order Allow,Deny
    Allow from all
</Files>

# Configurar tipo MIME para PDF
AddType application/pdf .pdf

# Permitir visualización inline de PDFs
<FilesMatch "\.pdf$">
    Header set Content-Disposition "inline"
    Header set Content-Type "application/pdf"
</FilesMatch>

# Permitir descarga de otros archivos
<FilesMatch "\.(doc|docx|txt|epub)$">
    Header set Content-Disposition "attachment"
</FilesMatch>
